__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/

# Secrets are NEVER committed. The guidelines require .env in .gitignore.
.env
.env.*
!.env.example

# Private keys are NEVER committed. Synthetic fixture keys generated by
# tools/gen_network.py live here and stay out of the repository.
network/.keys/
*.key
!network/fixtures/**/*.key.example

# Generated outputs
out/
*.log

# macOS
.DS_Store
.AppleDouble
._*
